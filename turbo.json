{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "AUTH_SECRET",
    "AUTH_TRUST_HOST",
    "AUTH_COOKIE_DOMAIN",
    "AUTH_URL",
    "NEXTAUTH_URL",
    "TMDB_API_KEY",
    "NEXT_PUBLIC_TMDB_API_KEY",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_EGFILM_URL",
    "NEXT_PUBLIC_EGSPORT_URL",
    "NEXT_PUBLIC_TURN_SERVER",
    "NEXT_PUBLIC_TURN_USERNAME",
    "TURN_PASSWORD",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "NEXT_PUBLIC_BUILD_VERSION",
    "NEXT_PUBLIC_BUILD_DATE",
    "NEXT_PUBLIC_GIT_SHA",
    "NEXT_PUBLIC_BLOG_SITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^db:generate"],
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "outputs": ["node_modules/.prisma/**", "node_modules/@prisma/client/**"]
    },
    "db:migrate": {
      "cache": false,
      "persistent": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:seed": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
