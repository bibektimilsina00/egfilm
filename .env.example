# ===================================================================
# EGFilm + EGLive monorepo environment.
# Copy to .env at repo root, plus per-app .env files for local dev
# (apps/egfilm/.env, apps/eglive/.env).
# ===================================================================

# ---------- Postgres (shared) ----------
POSTGRES_DB=egfilm
POSTGRES_USER=egfilm
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://egfilm:changeme@postgres:5432/egfilm

# ---------- NextAuth (shared user pool) ----------
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
# Per-app AUTH_URL — used as canonical NextAuth URL per domain.
EGFILM_AUTH_URL=https://egfilm.xyz
EGLIVE_AUTH_URL=https://eglive.xyz

# ---------- Public URLs ----------
EGFILM_URL=https://egfilm.xyz
EGLIVE_URL=https://eglive.xyz
NEXT_PUBLIC_BLOG_SITE_URL=https://blog.egfilm.xyz

# ---------- Local ports ----------
EGFILM_PORT=8000
EGLIVE_PORT=8001

# ---------- TMDB (egfilm only) ----------
TMDB_API_KEY=

# ---------- sportsrc.org (eglive) ----------
# No API key required.

# ---------- WebRTC TURN (both apps share) ----------
NEXT_PUBLIC_TURN_SERVER=turn:turn.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=
TURN_PASSWORD=

# ---------- Analytics / build metadata ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_BUILD_VERSION=0.1.0
NEXT_PUBLIC_BUILD_DATE=
NEXT_PUBLIC_GIT_SHA=

# ---------- Registry / deploy ----------
EGFILM_IMAGE_NAME=ghcr.io/bibektimilsina00/egfilm:latest
EGLIVE_IMAGE_NAME=ghcr.io/bibektimilsina00/eglive:latest
REGISTRY=ghcr.io
DEPLOY_USER=
REGISTRY_TOKEN=
