# ===================================================================
# EGFilm + EGSport monorepo environment.
# Copy to .env at repo root, plus per-app .env files for local dev
# (apps/egfilm/.env, apps/egsport/.env).
# ===================================================================

# ---------- Postgres (shared) ----------
POSTGRES_DB=egfilm
POSTGRES_USER=egfilm
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://egfilm:changeme@postgres:5432/egfilm

# ---------- NextAuth (shared user pool + SSO) ----------
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
# Cross-subdomain SSO: set cookie domain to your apex with a leading dot.
# Leave blank for local dev (cookie scoped to localhost per-port).
AUTH_COOKIE_DOMAIN=.egfilm.xyz
# Per-app AUTH_URL — canonical NextAuth URL per subdomain.
EGFILM_AUTH_URL=https://egfilm.xyz
EGSPORT_AUTH_URL=https://sports.egfilm.xyz

# ---------- Public URLs ----------
EGFILM_URL=https://egfilm.xyz
EGSPORT_URL=https://sports.egfilm.xyz
NEXT_PUBLIC_BLOG_SITE_URL=https://blog.egfilm.xyz

# ---------- Local ports ----------
EGFILM_PORT=8000
EGSPORT_PORT=8001

# ---------- TMDB (egfilm only) ----------
TMDB_API_KEY=

# ---------- sportsrc.org (egsport) ----------
# No API key required.

# ---------- WebRTC TURN (both apps share) ----------
NEXT_PUBLIC_TURN_SERVER=turn:turn.example.com:3478
NEXT_PUBLIC_TURN_USERNAME=
TURN_PASSWORD=

# ---------- Analytics / build metadata ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_BUILD_VERSION=0.1.0
NEXT_PUBLIC_BUILD_DATE=
NEXT_PUBLIC_GIT_SHA=

# ---------- Registry / deploy ----------
EGFILM_IMAGE_NAME=ghcr.io/bibektimilsina00/egfilm:latest
EGSPORT_IMAGE_NAME=ghcr.io/bibektimilsina00/egsport:latest
REGISTRY=ghcr.io
DEPLOY_USER=
REGISTRY_TOKEN=
